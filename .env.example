# Copy this file to .env and fill in the values
# .env is in .gitignore and will NOT be committed

# ── Security (required) ──────────────────────────────
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Multi-tenancy ────────────────────────────────────
ALLOWED_TENANTS=acme-corp,globex-inc,default

# ── Billing Database ─────────────────────────────────
BILLING_DB_URL=jdbc:postgresql://localhost:5433/billing
BILLING_DB_USERNAME=billing
BILLING_DB_PASSWORD=billing

# ── Payments Database ────────────────────────────────
PAYMENTS_DB_URL=jdbc:postgresql://localhost:5434/payments
PAYMENTS_DB_USERNAME=payments
PAYMENTS_DB_PASSWORD=payments

# ── Contracts Database ───────────────────────────────
CONTRACTS_DB_URL=jdbc:postgresql://localhost:5435/contracts
CONTRACTS_DB_USERNAME=contracts
CONTRACTS_DB_PASSWORD=contracts

# ── Inter-service Communication ──────────────────────
BILLING_SERVICE_URL=http://localhost:8082

# ── Messaging (RabbitMQ) ─────────────────────────────
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# ── Scheduling (cron uses Spring 6-field syntax: sec min hour dom mon dow) ──
SCHEDULING_ENABLED=true
RECURRING_INVOICES_CRON=0 0 2 * * *
MARK_OVERDUE_CRON=0 0 1 * * *
OUTBOX_POLL_DELAY_MS=10000

# ── Rate Limiting (token bucket per user/IP, in-memory) ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_SECONDS=60

# ── Resilience4j — payments → Stripe ─────────────────
STRIPE_RETRY_MAX_ATTEMPTS=3
STRIPE_RETRY_WAIT=500ms
STRIPE_CB_WINDOW=10
STRIPE_CB_FAILURE_RATE=50
STRIPE_CB_OPEN_WAIT=30s

# ── Resilience4j — contracts → billing ───────────────
BILLING_RETRY_MAX_ATTEMPTS=3
BILLING_RETRY_WAIT=500ms
BILLING_CB_WINDOW=10
BILLING_CB_FAILURE_RATE=50
BILLING_CB_OPEN_WAIT=30s

# ── Connection Pool (shared defaults) ────────────────
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000

# ── Observability ────────────────────────────────────
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SQL=WARN
ACTUATOR_ENDPOINTS=health,info,metrics,prometheus
ACTUATOR_HEALTH_DETAILS=when_authorized
# Trace sampling probability (1.0 = sample everything; lower in production, e.g. 0.1)
TRACING_SAMPLING=1.0

# ── Server ───────────────────────────────────────────
# SERVER_PORT is module-specific (8081=payments, 8082=billing, 8083=contracts)
SHUTDOWN_TIMEOUT=30s
